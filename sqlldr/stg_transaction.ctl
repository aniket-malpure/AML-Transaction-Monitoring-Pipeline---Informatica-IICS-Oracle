-- SQL*Loader control file for STG_TRANSACTION (LOCAL run mode).
-- Template: run_aml_batch.sh replaces __BATCH_ID__ and __DATA_FILE__ per run.
-- TRUNCATE makes a rerun of this step safe; errors go to the .bad file.
OPTIONS (SKIP=1, ERRORS=100000, DIRECT=TRUE, PARALLEL=FALSE)
LOAD DATA
CHARACTERSET AL32UTF8
INFILE '__DATA_FILE__'
TRUNCATE
INTO TABLE STG_TRANSACTION
FIELDS TERMINATED BY '|' OPTIONALLY ENCLOSED BY '"'
TRAILING NULLCOLS
(
  TXN_ID,
  ACCOUNT_ID,
  TXN_TS,
  TXN_TYPE,
  CHANNEL,
  DIRECTION,
  AMOUNT,
  CURRENCY,
  COUNTERPARTY_NAME      CHAR(200),
  COUNTERPARTY_COUNTRY,
  STATUS,
  BATCH_ID               CONSTANT "__BATCH_ID__",
  SRC_FILE_NAME          CONSTANT "__FILE_NAME__",
  LOAD_TS                SYSDATE
)
