# ============================================================================
# aml_pipeline.env.example
# Copy to config/aml_pipeline.env (git-ignored) and fill in. Every script
# sources it through scripts/lib/common.sh.
# ============================================================================

# --- paths -------------------------------------------------------------------
export AML_HOME="${AML_HOME:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
export AML_INBOUND_DIR="${AML_INBOUND_DIR:-${AML_HOME}/data/inbound}"
export AML_OUTBOUND_DIR="${AML_OUTBOUND_DIR:-${AML_HOME}/data/outbound}"
export AML_ARCHIVE_DIR="${AML_ARCHIVE_DIR:-${AML_HOME}/data/archive}"
export AML_LOG_DIR="${AML_LOG_DIR:-${AML_HOME}/logs}"
export AML_RUN_DIR="${AML_RUN_DIR:-${AML_HOME}/run}"
export AML_ARCHIVE_RETENTION_DAYS="${AML_ARCHIVE_RETENTION_DAYS:-90}"
export AML_LOG_RETENTION_DAYS="${AML_LOG_RETENTION_DAYS:-30}"

# --- Oracle --------------------------------------------------------------------
# Instant Client 19c+ (sqlplus, sqlldr) must be on PATH.
export AML_DB_USER="${AML_DB_USER:-AML_OWNER}"
export AML_DB_PASSWORD="${AML_DB_PASSWORD:-}"                 # prefer an Oracle wallet: leave empty and set AML_DB_USE_WALLET=Y
export AML_DB_CONNECT="${AML_DB_CONNECT:-//localhost:1521/FREEPDB1}"
export AML_DB_USE_WALLET="${AML_DB_USE_WALLET:-N}"              # Y = connect /@AML_DB_CONNECT using TNS_ADMIN wallet
export NLS_LANG="${NLS_LANG:-AMERICAN_AMERICA.AL32UTF8}"
export NLS_NUMERIC_CHARACTERS="${NLS_NUMERIC_CHARACTERS:-.,}"

# --- Run mode ----------------------------------------------------------------
# IICS  : files land in Oracle through IICS mapping tasks (production path)
# LOCAL : SQL*Loader replaces the IICS tasks (dev laptop / CI without IICS)
export AML_RUN_MODE="${AML_RUN_MODE:-LOCAL}"

# --- Informatica Intelligent Cloud Services ------------------------------------
export IICS_LOGIN_URL="${IICS_LOGIN_URL:-https://dm-us.informaticacloud.com/ma/api/v2/user/login}"
export IICS_USERNAME="${IICS_USERNAME:-}"
export IICS_PASSWORD="${IICS_PASSWORD:-}"                   # inject from a secrets manager in CI, never commit
export IICS_PARAM_DIR="${IICS_PARAM_DIR:-/opt/infaagent/apps/Data_Integration_Server/data/userparameters/aml}"
export IICS_POLL_SECONDS="${IICS_POLL_SECONDS:-20}"
export IICS_TASK_TIMEOUT_SECONDS="${IICS_TASK_TIMEOUT_SECONDS:-5400}"      # 90 minutes per mapping task

# --- Retry policy ---------------------------------------------------------------
export AML_STEP_MAX_ATTEMPTS="${AML_STEP_MAX_ATTEMPTS:-3}"             # IICS / SQL*Loader steps (transient failures)
export AML_PLSQL_MAX_ATTEMPTS="${AML_PLSQL_MAX_ATTEMPTS:-1}"            # PL/SQL steps fail fast: errors are data/logic, not transient
export AML_RETRY_BACKOFF_SECONDS="${AML_RETRY_BACKOFF_SECONDS:-60}"

# --- Notifications ------------------------------------------------------------
export AML_ALERT_EMAIL="${AML_ALERT_EMAIL:-fcrm-data-ops@example.com}"
export AML_MAILER="${AML_MAILER:-mailx}"                 # set to "none" to disable
